{
  "name": "afrocoils",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/subset-icons.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "icons:subset": "node scripts/subset-icons.mjs",
    "cap:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run cap:sync && cap run android",
    "android:build": "npm run cap:sync && cd android && .\\gradlew.bat assembleDebug",
    "android:release": "npm run cap:sync && cd android && .\\gradlew.bat assembleRelease",
    "android:bundle": "npm run cap:sync && cd android && .\\gradlew.bat bundleRelease",
    "apk": "node scripts/build-apk.mjs",
    "images:check": "node scripts/check-images.mjs",
    "images:prompts": "node scripts/gen-image-prompts.mjs",
    "images:import": "node scripts/import-drive-images.mjs",
    "site:release": "node scripts/site-release.mjs",
    "ota:publish": "node scripts/ota-publish.mjs",
    "site:dev": "vite --config vite.site.config.ts",
    "site:build": "tsc -p tsconfig.site.json && vite build --config vite.site.config.ts",
    "site:preview": "vite preview --config vite.site.config.ts",
    "images:generated": "node scripts/import-generated-images.mjs",
    "images:locs": "node scripts/import-loc-images.mjs",
    "brand:import": "node scripts/import-brand.mjs",
    "ask:eval": "node scripts/ask-eval.mjs",
    "ask:study": "node scripts/ask-study.mjs",
    "backend:deploy": "supabase functions deploy submissions --no-verify-jwt --use-api && supabase functions deploy questions --no-verify-jwt --use-api",
    "db:push": "supabase db push --linked"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-updater": "8.52.1",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.21",
    "fflate": "0.8.3",
    "material-symbols": "^0.45.9",
    "postcss": "^8.5.6",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "subset-font": "^2.5.0",
    "supabase": "2.120.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.2",
    "vite": "^8.1.5"
  }
}

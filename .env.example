# ---------------------------------------------------------------------------
# The app makes no model calls, and it holds no secret of any kind. Every
# guide, style and step ships inside the bundle and is filtered on the
# device. Everything in this file is a public URL.
#
# The backend is one Supabase project (runhkccoeyxfgsfrzezn): the
# submissions Edge Function, its tables and photo bucket, and the public
# `releases` bucket. Supabase injects the service key into the function
# itself, so there is nothing secret to set here or anywhere else — see
# README, "The backend".
#
# NEVER put a Supabase key in a VITE_ variable. Anything VITE_-prefixed is
# inlined into the bundle and ships inside the APK and every pushed update.
# vite.config.ts refuses to build if it finds one.
#
# Release builds read .env.production (gitignored), and `npm run apk` and
# `npm run ota:publish` refuse to run unless it sets both values below.
# Leave them empty in .env for `npm run dev`.
# ---------------------------------------------------------------------------

# Where the submissions function lives. Empty for `npm run dev`: only the
# "Share a style" button needs it, and it says so.
#
#   VITE_API_BASE_URL=https://runhkccoeyxfgsfrzezn.supabase.co/functions/v1
VITE_API_BASE_URL=

# latest.json in the public `releases` bucket: the newest APK and the newest
# pushed update. Empty and the build never checks; About says so. A Google
# Play build must leave it empty (docs/play-release.md).
#
#   VITE_UPDATE_MANIFEST_URL=https://runhkccoeyxfgsfrzezn.supabase.co/storage/v1/object/public/releases/latest.json
VITE_UPDATE_MANIFEST_URL=

# Development only, not VITE_: point `npm run dev`'s /submissions proxy at a
# functions base to test the submit screen against a real backend.
#
#   DEV_API_PROXY=https://runhkccoeyxfgsfrzezn.supabase.co/functions/v1
DEV_API_PROXY=

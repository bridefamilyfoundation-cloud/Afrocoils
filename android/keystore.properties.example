# Copy to `keystore.properties` (gitignored) to produce a signed release build.
# Fill in the values for your own keystore — never commit real ones here.
#
# ---------------------------------------------------------------------------
# For Google Play: generate an UPLOAD key
# ---------------------------------------------------------------------------
# Under Play App Signing, Google holds the real app signing key. You sign each
# upload with a separate upload key, which Google verifies and strips before
# re-signing the artifact with the app signing key.
#
#   keytool -genkeypair -v -keystore afro-coily-upload.keystore \
#     -alias afro-coily-upload -keyalg RSA -keysize 2048 -validity 10000 \
#     -dname "CN=Afrocoil, O=Afrocoil, C=NG"
#
# 10000 days is deliberate — Play rejects keys expiring before 2033.
#
# Back up the .keystore file AND both passwords somewhere off this machine.
# Losing them is recoverable while enrolled in Play App Signing (Google can
# reset an upload key, taking a few days). Losing them while NOT enrolled is
# terminal: the listing can never be updated again.
#
# storeFile=afro-coily-upload.keystore
# keyAlias=afro-coily-upload
#
# ---------------------------------------------------------------------------
# For local sideloading only
# ---------------------------------------------------------------------------
# `afro-coily-dev.keystore` is a THROWAWAY key for installing on your own
# devices. Never upload a build signed with it to Play — applicationId and
# signing identity are bound together permanently on first upload.

storeFile=afro-coily-dev.keystore
storePassword=CHANGE_ME
keyAlias=afro-coily-dev
keyPassword=CHANGE_ME
